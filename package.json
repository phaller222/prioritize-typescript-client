{
  "name": "prioritize-client",
  "version": "1.4.0",
  "description": "Official spec-first TypeScript/JavaScript client for the Prioritize REST API (generated with OpenAPI Generator, typescript-fetch).",
  "author": "Peter Haller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaller222/prioritize-typescript-client.git"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^4.0 || ^5.0"
  },
  "homepage": "https://github.com/phaller222/prioritize-typescript-client#readme",
  "keywords": [
    "prioritize",
    "rest",
    "client",
    "api",
    "openapi",
    "typescript",
    "iot",
    "nfc",
    "project-management"
  ],
  "files": [
    "dist",
    "src"
  ]
}
